{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@ledger/core": ["./packages/core/src/index.ts"],
      "@ledger/core/*": ["./packages/core/src/*"],
      "@ledger/db": ["./packages/db/src/index.ts"],
      "@ledger/db/*": ["./packages/db/src/*"]
    }
  }
}
