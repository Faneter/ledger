{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeekLedger",
  "version": "1.0.0",
  "identifier": "dev.faneter.geekledger",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "极客大学生个人记账与预算系统 (Local-First Replica)",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/icon.svg"
    ]
  }
}
