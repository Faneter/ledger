{
  "name": "geek-student-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm --filter @ledger/client build",
    "build:core-rs": "node packages/core-rs/build-wasm.mjs",
    "start": "pnpm --filter @ledger/client build && pnpm --filter @ledger/server start",
    "start:server": "pnpm --filter @ledger/server start",
    "dev:client": "pnpm --filter @ledger/client dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
